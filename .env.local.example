# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# pgcrypto encryption passphrase — server only, must match the key used for encrypted cost_basis
SUPABASE_ENCRYPTION_KEY=replace-with-a-strong-random-secret-at-least-32-chars

# Market data
FINNHUB_API_KEY=your_finnhub_api_key

# Groq AI
GROQ_API_KEY=your_groq_api_key

# Vercel Cron authentication — use a separate random secret
CRON_SECRET=replace-with-a-strong-random-secret-at-least-32-chars

# PIN security — keep these two secrets distinct from each other and from CRON_SECRET
PIN_PEPPER=replace-with-a-strong-random-secret-at-least-32-chars
PIN_SESSION_SECRET=replace-with-a-different-random-secret-at-least-32-chars

# Optional: absolute server-side PIN session ceiling in seconds (default 14400 = 4 hours)
PIN_SESSION_MAX_AGE_SEC=14400
